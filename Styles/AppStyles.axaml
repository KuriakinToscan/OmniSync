<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource OsWindowBrush}" />
    </Style>

    <!-- Texto secundário -->
    <Style Selector="TextBlock.subtle">
        <Setter Property="Foreground" Value="{DynamicResource OsSubtleTextBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource OsSubtleTextBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Cartões -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource OsCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Ícones -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="PathIcon.small">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
    </Style>

    <!-- Cores semânticas por tipo de ação -->
    <Style Selector=":is(Control).new">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsNewBrush}" />
    </Style>
    <Style Selector=":is(Control).conflict">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsConflictBrush}" />
    </Style>
    <Style Selector=":is(Control).orphan">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsOrphanBrush}" />
    </Style>
    <Style Selector=":is(Control).identical">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsIdenticalBrush}" />
    </Style>
    <Style Selector=":is(Control).error">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsErrorBrush}" />
    </Style>
    <Style Selector=":is(Control).warning">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsConflictBrush}" />
    </Style>

    <!-- Botões de filtro (chips) -->
    <Style Selector=":is(Button).chip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource OsCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.chip.active">
        <Setter Property="Background" Value="{DynamicResource OsChipActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OsChipActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OsChipActiveTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.chip.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource OsChipActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OsChipActiveTextBrush}" />
    </Style>

    <!-- Cartões de métrica clicáveis -->
    <Style Selector="Button.metric">
        <Setter Property="Background" Value="{DynamicResource OsCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.metric:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource OsCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OsCardBorderBrush}" />
    </Style>
    <Style Selector="Button.metric.active /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource OsChipActiveTextBrush}" />
    </Style>
    <Style Selector="Button.metric TextBlock.value">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Botão com ícone e texto -->
    <Style Selector="Button.icon-text">
        <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Faixas de aviso e perigo -->
    <Style Selector="Border.warning-banner">
        <Setter Property="Background" Value="{DynamicResource OsWarningBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OsWarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsWarningTextBrush}" />
    </Style>
    <Style Selector="Border.danger-banner">
        <Setter Property="Background" Value="{DynamicResource OsDangerBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OsDangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsDangerTextBrush}" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource OsChipActiveBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OsChipActiveTextBrush}" />
    </Style>

    <!-- Grade -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource OsCardBrush}" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontSize" Value="12" />
    </Style>
</Styles>
