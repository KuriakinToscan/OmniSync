<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmniSync.App"
             RequestedThemeVariant="Default">
    <!-- "Default" segue o tema claro/escuro configurado no sistema operacional (Windows/Linux) -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OmniSync/Styles/Palette.axaml" />
                <ResourceInclude Source="avares://OmniSync/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <!-- Cor de destaque própria (verde-azulado) no lugar do azul padrão do sistema -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#FF0E6E6D" />
                <ColorPaletteResources x:Key="Dark" Accent="#FF2FA3A1" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://OmniSync/Styles/AppStyles.axaml"/>
    </Application.Styles>
</Application>
