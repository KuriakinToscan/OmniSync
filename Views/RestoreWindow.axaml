<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniSync.ViewModels"
        xmlns:models="using:OmniSync.Models"
        x:Class="OmniSync.Views.RestoreWindow"
        x:DataType="vm:RestoreViewModel"
        Icon="/Assets/omnisync.ico"
        Title="Restaurar de lixo/"
        Width="820" Height="560" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20,16" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <StackPanel Spacing="2">
            <TextBlock Text="Restaurar arquivos de lixo/" FontSize="18" FontWeight="Bold" />
            <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                       Text="Os arquivos marcados voltam ao local original no destino. Nada é sobrescrito nem excluído: se o local original já estiver ocupado, o arquivo permanece em lixo/." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">
            <Button Classes="ghost" Content="Marcar todos" Command="{Binding SelectAllCommand}" />
            <Button Grid.Column="1" Classes="ghost" Content="Desmarcar todos" Command="{Binding SelectNoneCommand}" />
            <TextBlock Grid.Column="2" Text="{Binding SelectionText}" Classes="subtle" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource OsCardBorderBrush}" CornerRadius="8">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:TrashEntry">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" MinWidth="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Caminho em lixo/" Binding="{Binding RelativePath}" Width="*" />
                <DataGridTextColumn Header="Tamanho" Binding="{Binding FormattedSize}" SortMemberPath="Size" Width="100" />
                <DataGridTextColumn Header="Modificado" Binding="{Binding FormattedDate}" SortMemberPath="ModifiedUtc" Width="170" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Padding="16,8" IsCancel="True" />
            <Button Content="Restaurar selecionados" Command="{Binding RestoreCommand}" Classes="accent" Padding="18,8" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
