<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniSync.ViewModels"
        xmlns:models="using:OmniSync.Models"
        xmlns:views="using:OmniSync.Views"
        x:Class="OmniSync.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/omnisync.ico"
        Title="OmniSync"
        Width="1120" Height="760"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding StartSyncCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </Window.KeyBindings>

    <Grid Margin="18,14,18,12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

        <!-- 1. Cabeçalho -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="/Assets/omnisync.png" Width="34" Height="34" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OmniSync" FontSize="18" FontWeight="Bold" />
                    <TextBlock Classes="caption" Text="Sincronização unidirecional com lixeira (lixo/) e histórico de versões (old/)" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Command="{Binding OpenLogsFolderCommand}"
                    ToolTip.Tip="Abrir a pasta com os logs completos de todas as execuções"
                    AutomationProperties.Name="Abrir pasta de logs">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconLog}" Classes="small" />
                    <TextBlock Text="Logs" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Seleção de pastas, opções e ações -->
        <Border Grid.Row="1" Classes="card" Padding="14,12" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconFolder}" Classes="small" />
                            <TextBlock Classes="section" Text="Origem" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding SourcePath}" PlaceholderText="Ex.: E:\Projetos ou /home/usuario/docs"
                                     AutomationProperties.Name="Diretório de origem" />
                            <Button Grid.Column="1" Content="Procurar..." Command="{Binding BrowseSourceCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconDrive}" Classes="small" />
                            <TextBlock Classes="section" Text="Destino (local ou NAS)" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DestinationPath}" PlaceholderText="Ex.: \\nas\backup ou /mnt/nas/backup"
                                     AutomationProperties.Name="Diretório de destino" />
                            <Button Grid.Column="1" Content="Procurar..." Command="{Binding BrowseDestinationCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <WrapPanel VerticalAlignment="Center" ItemSpacing="16" LineSpacing="4">
                        <CheckBox Content="Subpasta com nome da origem"
                                  IsChecked="{Binding UseSourceFolderNameInDestination}"
                                  ToolTip.Tip="Origem 'E:\Fotos' + Destino 'G:\' sincroniza em 'G:\Fotos' sem afetar outras pastas do drive G:" />
                        <CheckBox Content="Verificar conteúdo (SHA-256)"
                                  IsChecked="{Binding EnableDeepHashCheck}"
                                  ToolTip.Tip="Arquivos de mesmo tamanho são comparados pelo conteúdo, não pela data. Mais lento, mais seguro." />
                        <CheckBox Content="Tolerar 1 h (horário de verão)"
                                  IsChecked="{Binding TolerateDstShift}"
                                  ToolTip.Tip="Considera iguais arquivos cuja data difere exatamente 1 hora. Útil com pendrives/HDs em FAT ou exFAT." />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Ignorar:" VerticalAlignment="Center" Classes="subtle" />
                            <TextBox Text="{Binding ExcludePatternsText}" Width="230"
                                     ToolTip.Tip="Padrões separados por ponto e vírgula, aplicados ao nome de arquivos e pastas (* e ?). Ex.: Thumbs.db; ~$*; *.tmp"
                                     AutomationProperties.Name="Padrões de exclusão" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="icon-text" Command="{Binding ScanCommand}" ToolTip.Tip="Analisar diferenças sem alterar nada (F5)">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconSearch}" Classes="small" />
                                <TextBlock Text="Analisar" />
                            </StackPanel>
                        </Button>
                        <Button Classes="accent icon-text" Command="{Binding StartSyncCommand}" ToolTip.Tip="Revisar o plano e sincronizar (Ctrl+Enter)">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconPlay}" Classes="small" />
                                <TextBlock Text="Sincronizar" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Classes="icon-text" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" ToolTip.Tip="Cancelar (Esc)">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconClose}" Classes="small" />
                                <TextBlock Text="Cancelar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Avisos da análise -->
        <Border Grid.Row="2" Classes="warning-banner" Margin="0,0,0,10" IsVisible="{Binding HasScanWarnings}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Data="{StaticResource IconWarning}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <ScrollViewer Grid.Column="1" MaxHeight="72" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ScanWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 4. Resumo (cartões clicáveis filtram a grade) -->
        <Grid Grid.Row="3" ColumnDefinitions="*,10,*,10,*,10,*,10,*" Margin="0,0,0,10">
            <Button Grid.Column="0" Classes="metric"
                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.New}}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.New}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconPlus}" Classes="small new" />
                        <TextBlock Classes="caption" Text="Novos a copiar" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="value new" Text="{Binding NewCount}" />
                        <TextBlock Classes="caption" Text="{Binding NewBytesFormatted}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="metric"
                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Conflicts}}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Conflicts}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconConflict}" Classes="small conflict" />
                        <TextBlock Classes="caption" Text="Conflitos" />
                    </StackPanel>
                    <TextBlock Classes="value conflict" Text="{Binding ConflictCount}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="metric"
                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Orphans}}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Orphans}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconTrash}" Classes="small orphan" />
                        <TextBlock Classes="caption" Text="Órfãos (p/ lixo/)" />
                    </StackPanel>
                    <TextBlock Classes="value orphan" Text="{Binding TrashCount}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="6" Classes="metric"
                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Identical}}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Identical}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconCheck}" Classes="small identical" />
                        <TextBlock Classes="caption" Text="Idênticos" />
                    </StackPanel>
                    <TextBlock Classes="value identical" Text="{Binding IdenticalCount}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="8" Classes="metric"
                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Errors}}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Errors}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconError}" Classes="small error" />
                        <TextBlock Classes="caption" Text="Erros" />
                    </StackPanel>
                    <TextBlock Classes="value error" Text="{Binding ErrorCount}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 5. Prévia e Log -->
        <TabControl Grid.Row="4" Margin="0,0,0,8" Padding="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconList}" Classes="small" />
                        <TextBlock Text="Prévia" FontSize="14" />
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    <!-- Filtros e busca -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <WrapPanel ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                            <Button Classes="chip" Content="Todos"
                                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.All}}"
                                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.All}" />
                            <Button Classes="chip" Content="Novos"
                                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.New}}"
                                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.New}" />
                            <Button Classes="chip" Content="Conflitos"
                                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Conflicts}}"
                                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Conflicts}" />
                            <Button Classes="chip" Content="Órfãos"
                                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Orphans}}"
                                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Orphans}" />
                            <Button Classes="chip" Content="Idênticos"
                                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Identical}}"
                                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Identical}" />
                            <Button Classes="chip" Content="Erros"
                                    Classes.active="{Binding ActiveFilter, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter={x:Static vm:ItemFilter.Errors}}"
                                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ItemFilter.Errors}" />
                            <DropDownButton Classes="chip" IsVisible="{Binding CanEditConflicts}" Margin="8,0,0,0"
                                            ToolTip.Tip="Definir a decisão de todos os conflitos pendentes antes de sincronizar">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconConflict}" Classes="small conflict" />
                                    <TextBlock Text="Decidir conflitos" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Mais recente vence (substitui só quando a origem é mais nova)" Command="{Binding MarkConflictsNewestWinsCommand}" />
                                        <MenuItem Header="Substituir todos (versões atuais vão para old/)" Command="{Binding MarkAllConflictsAsReplaceCommand}" />
                                        <MenuItem Header="Ignorar todos (manter destino)" Command="{Binding MarkAllConflictsAsIgnoreCommand}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </WrapPanel>
                        <TextBox Grid.Column="1" Width="240" VerticalAlignment="Top" Text="{Binding SearchText}"
                                 PlaceholderText="Buscar no caminho..." AutomationProperties.Name="Buscar no caminho">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource IconSearch}" Classes="small" Margin="8,0,0,0" Opacity="0.6" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Grid>

                    <Panel Grid.Row="1">
                        <DataGrid ItemsSource="{Binding FilteredItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource OsCardBorderBrush}"
                                  CornerRadius="8">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ação" Width="190" SortMemberPath="ActionDisplay">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:SyncItem">
                                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="10,0" VerticalAlignment="Center"
                                                        Classes.new="{Binding IsNew}" Classes.conflict="{Binding IsConflict}"
                                                        Classes.orphan="{Binding IsOrphan}" Classes.identical="{Binding IsIdentical}">
                                                <Panel Width="13" Height="13">
                                                    <PathIcon Data="{StaticResource IconPlus}" Classes="small" IsVisible="{Binding IsNew}" />
                                                    <PathIcon Data="{StaticResource IconConflict}" Classes="small" IsVisible="{Binding IsConflict}" />
                                                    <PathIcon Data="{StaticResource IconTrash}" Classes="small" IsVisible="{Binding IsOrphan}" />
                                                    <PathIcon Data="{StaticResource IconCheck}" Classes="small" IsVisible="{Binding IsIdentical}" />
                                                </Panel>
                                                <TextBlock Text="{Binding ActionDisplay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Caminho relativo" Binding="{Binding RelativePath}" Width="*" MinWidth="200" />

                                <DataGridTemplateColumn Header="Decisão" Width="120" SortMemberPath="ResolutionIndex">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:SyncItem">
                                            <ComboBox IsVisible="{Binding IsConflict}" IsEnabled="{Binding !IsProcessed}"
                                                      SelectedIndex="{Binding ResolutionIndex, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" Margin="4,2" FontSize="12" MinHeight="26" Padding="8,2">
                                                <ComboBoxItem Content="Perguntar" />
                                                <ComboBoxItem Content="Substituir" />
                                                <ComboBoxItem Content="Ignorar" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Tam. orig." Binding="{Binding FormattedSourceSize}" SortMemberPath="SourceSize" Width="92" />
                                <DataGridTextColumn Header="Tam. dest." Binding="{Binding FormattedDestinationSize}" SortMemberPath="DestinationSize" Width="92" />
                                <DataGridTextColumn Header="Modif. origem" Binding="{Binding ShortSourceDate}" SortMemberPath="SourceModifiedUtc" Width="128" />
                                <DataGridTextColumn Header="Modif. destino" Binding="{Binding ShortDestinationDate}" SortMemberPath="DestinationModifiedUtc" Width="128" />

                                <DataGridTemplateColumn Header="Status" Width="160" SortMemberPath="StatusMessage">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:SyncItem">
                                            <TextBlock Text="{Binding StatusMessage}" Classes.error="{Binding HasError}"
                                                       Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding StatusMessage}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding EmptyStateText}" IsVisible="{Binding IsEmptyStateVisible}"
                                   Classes="subtle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" IsHitTestVisible="False" />
                    </Panel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconLog}" Classes="small" />
                        <TextBlock Text="Registro" FontSize="14" />
                    </StackPanel>
                </TabItem.Header>
                <Border Classes="card" Margin="0,8,0,0" Padding="4">
                    <ListBox ItemsSource="{Binding Logs}" Background="Transparent"
                             FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogEntry">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Text="{Binding Time}" Classes="subtle" />
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                               Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 6. Progresso (visível só durante operações) -->
        <Border Grid.Row="5" Classes="card" Padding="12,10" Margin="0,0,0,8" IsVisible="{Binding IsBusy}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding CurrentOperationText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding ProcessedFilesText}" Classes="subtle" />
                        <TextBlock Text="{Binding SpeedFormatted}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EtaFormatted}" Classes="subtle" ToolTip.Tip="Tempo restante estimado" />
                    </StackPanel>
                </Grid>
                <ProgressBar Value="{Binding OverallProgress}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Minimum="0" Maximum="100" Height="6" CornerRadius="3" />
            </StackPanel>
        </Border>

        <!-- 7. Barra de status e acesso às pastas de segurança -->
        <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding StatusMessage}" Classes="subtle" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Classes="ghost" Command="{Binding ExportReportCommand}" ToolTip.Tip="Exportar a análise/resultado em CSV">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconExport}" Classes="small" />
                        <TextBlock Text="Exportar CSV" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding RestoreTrashCommand}" ToolTip.Tip="Escolher arquivos de lixo/ para devolver ao local original">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconRestore}" Classes="small" />
                        <TextBlock Text="Restaurar de lixo/" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding OpenTrashFolderCommand}" ToolTip.Tip="Abrir destino/lixo/">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconTrash}" Classes="small" />
                        <TextBlock Text="lixo/" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding OpenOldFolderCommand}" ToolTip.Tip="Abrir destino/old/ (versões substituídas)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconHistory}" Classes="small" />
                        <TextBlock Text="old/" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
