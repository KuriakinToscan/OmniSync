<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniSync.ViewModels"
        xmlns:models="using:OmniSync.Models"
        x:Class="OmniSync.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="OmniSync - Sincronizador de Arquivos Multiplataforma"
        Width="1050" Height="720"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- 1. Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{DynamicResource AccentButtonBackground}" CornerRadius="10" Width="38" Height="38">
                    <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="OmniSync" FontSize="18" FontWeight="Bold" />
                        <Border Background="{DynamicResource SystemChromeLowColor}" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Windows &amp; Linux" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Sincronizador inteligente de arquivos com suporte a Drives Locais e NAS" 
                               FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="{DynamicResource SystemChromeLowColor}" CornerRadius="6" Padding="10,6" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1">
                    <TextBlock Text="🖧 Pronto para NAS / UNC" FontSize="11.5" Foreground="{DynamicResource SystemBaseMediumColor}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Path Selector & Actions Card -->
        <Border Grid.Row="1" Background="{DynamicResource SystemChromeLowColor}" 
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" 
                CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                
                <Grid ColumnDefinitions="*,14,*">
                    <!-- Source Directory -->
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="📁 Diretório de Origem" FontWeight="SemiBold" FontSize="12.5" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding SourcePath}" PlaceholderText="Ex: G:\MeusProjetos ou /home/usuario/docs" FontSize="12" />
                            <Button Grid.Column="1" Content="Procurar..." Command="{Binding BrowseSourceCommand}" FontSize="12" />
                        </Grid>
                    </StackPanel>

                    <!-- Destination Directory -->
                    <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock Text="🖧 Diretório de Destino (Local ou NAS)" FontWeight="SemiBold" FontSize="12.5" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding DestinationPath}" PlaceholderText="Ex: \\nas\share\backup ou /mnt/nas/backup" FontSize="12" />
                            <Button Grid.Column="1" Content="Procurar..." Command="{Binding BrowseDestinationCommand}" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Options & Action Buttons -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <CheckBox Content="Criar/usar subpasta com nome da origem" 
                                  IsChecked="{Binding UseSourceFolderNameInDestination}" 
                                  ToolTip.Tip="Ex: Origem 'E:\Fotos' + Destino 'G:\' sincroniza em 'G:\Fotos' sem afetar outras pastas do drive G:"
                                  FontSize="12" />
                        <CheckBox Content="Verificação SHA-256" 
                                  IsChecked="{Binding EnableDeepHashCheck}" 
                                  FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="🔍 1. Analisar Diferenças (Dry-Run)" 
                                Command="{Binding ScanCommand}" 
                                IsEnabled="{Binding CanScan}"
                                Padding="14,8" FontSize="12" />

                        <Button Content="▶ 2. Iniciar Sincronização" 
                                Command="{Binding StartSyncCommand}" 
                                IsEnabled="{Binding CanSync}"
                                Classes="accent"
                                Padding="16,8" FontWeight="SemiBold" FontSize="12" />

                        <Button Content="✕ Cancelar" 
                                Command="{Binding CancelCommand}" 
                                IsVisible="{Binding IsBusy}"
                                Padding="12,8" FontSize="12" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- 3. Metrics Summary Badges -->
        <Grid Grid.Row="2" ColumnDefinitions="*,10,*,10,*,10,*" Margin="0,0,0,12">
            
            <!-- Novos -->
            <Border Grid.Column="0" Background="{DynamicResource SystemChromeLowColor}" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="3">
                    <TextBlock Text="Novos a Copiar" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding NewCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentButtonBackground}" />
                        <TextBlock Text="{Binding NewBytesFormatted}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Idênticos -->
            <Border Grid.Column="2" Background="{DynamicResource SystemChromeLowColor}" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="3">
                    <TextBlock Text="Idênticos (Ignorados)" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Text="{Binding IdenticalCount}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Conflitos -->
            <Border Grid.Column="4" Background="{DynamicResource SystemChromeLowColor}" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="⚠️ Conflitos" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <TextBlock Text="{Binding ConflictCount}" FontSize="18" FontWeight="Bold" Foreground="#D97706" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <Button Content="Todos p/ old/" Command="{Binding MarkAllConflictsAsReplaceCommand}" FontSize="10" Padding="4,2" ToolTip.Tip="Define todos os conflitos para Substituir (mover antigo p/ old)" />
                        <Button Content="Todos Ignorar" Command="{Binding MarkAllConflictsAsIgnoreCommand}" FontSize="10" Padding="4,2" ToolTip.Tip="Define todos os conflitos para Ignorar" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lixo / Órfãos -->
            <Border Grid.Column="6" Background="{DynamicResource SystemChromeLowColor}" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Spacing="3">
                    <TextBlock Text="🗑️ Órfãos (Para o Lixo)" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Text="{Binding TrashCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
                </StackPanel>
            </Border>

        </Grid>

        <!-- 4. Tabs: File Preview Table & Logs -->
        <TabControl Grid.Row="3" Margin="0,0,0,10">
            
            <!-- Tab 1: Preview DataGrid -->
            <TabItem Header="📋 Prévia de Arquivos">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    
                    <!-- Filters bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="Filtrar:" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,4,0"/>
                        <Button Content="Todos" Command="{Binding SetFilterCommand}" CommandParameter="Todos" FontSize="11" Padding="8,4" />
                        <Button Content="Novos" Command="{Binding SetFilterCommand}" CommandParameter="Novos" FontSize="11" Padding="8,4" />
                        <Button Content="Conflitos" Command="{Binding SetFilterCommand}" CommandParameter="Conflitos" FontSize="11" Padding="8,4" />
                        <Button Content="Órfãos (Lixo)" Command="{Binding SetFilterCommand}" CommandParameter="Lixo" FontSize="11" Padding="8,4" />
                        <Button Content="Idênticos" Command="{Binding SetFilterCommand}" CommandParameter="Identicos" FontSize="11" Padding="8,4" />
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredItems}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource SystemBaseLowColor}"
                              CornerRadius="6">
                        <DataGrid.Columns>
                            
                            <DataGridTextColumn Header="Ação Programada" 
                                                Binding="{Binding ActionDisplay}" 
                                                Width="190" />

                            <DataGridTextColumn Header="Caminho Relativo" 
                                                Binding="{Binding RelativePath}" 
                                                Width="*" />

                            <DataGridTextColumn Header="Tamanho Origem" 
                                                Binding="{Binding FormattedSourceSize}" 
                                                Width="110" />

                            <DataGridTextColumn Header="Tamanho Destino" 
                                                Binding="{Binding FormattedDestinationSize}" 
                                                Width="110" />

                            <DataGridTextColumn Header="Modificação Origem" 
                                                Binding="{Binding FormattedSourceDate}" 
                                                Width="150" />

                            <DataGridTextColumn Header="Status / Progresso" 
                                                Binding="{Binding StatusMessage}" 
                                                Width="170" />

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- Tab 2: Logs -->
            <TabItem Header="📜 Registro de Operações (Log)">
                <ListBox ItemsSource="{Binding Logs}" 
                         Margin="0,8,0,0"
                         FontFamily="Consolas, Cascadia Code, monospace" 
                         FontSize="11.5"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource SystemBaseLowColor}"
                         CornerRadius="6" />
            </TabItem>

        </TabControl>

        <!-- 5. Real-Time Progress Panel -->
        <Border Grid.Row="4" Background="{DynamicResource SystemChromeLowColor}" 
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" 
                CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding CurrentOperationText}" 
                               FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding ProcessedFilesText}" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <TextBlock Text="{Binding SpeedFormatted}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EtaFormatted}" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </StackPanel>
                </Grid>
                
                <ProgressBar Value="{Binding OverallProgress}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
            </StackPanel>
        </Border>

        <!-- 6. Bottom Bar & Quick Folder Access -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                       FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" 
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="↩ Restaurar de lixo/" Command="{Binding RestoreTrashCommand}" 
                        ToolTip.Tip="Restaura todos os arquivos da pasta lixo/ para seus locais originais"
                        FontSize="11.5" Padding="10,5" />
                <Button Content="Abrir destino/lixo/ ↗" Command="{Binding OpenTrashFolderCommand}" 
                        FontSize="11.5" Padding="10,5" />
                <Button Content="Abrir destino/old/ ↗" Command="{Binding OpenOldFolderCommand}" 
                        FontSize="11.5" Padding="10,5" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
