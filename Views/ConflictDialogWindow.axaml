<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniSync.ViewModels"
        x:Class="OmniSync.Views.ConflictDialogWindow"
        x:DataType="vm:ConflictDialogViewModel"
        Icon="/Assets/omnisync.ico"
        Title="Conflito de arquivo"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="14">
        <!-- Cabeçalho -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <PathIcon Data="{StaticResource IconConflict}" Width="26" Height="26" Classes="conflict" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Conflito de arquivo" FontSize="18" FontWeight="Bold" />
                <TextBlock Classes="subtle" FontSize="12" Text="O arquivo existe nos dois lados com conteúdo diferente." />
            </StackPanel>
        </StackPanel>

        <!-- Nome do arquivo -->
        <Border Classes="card" Padding="12,8">
            <TextBlock Text="{Binding Item.RelativePath}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace"
                       FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13" />
        </Border>

        <!-- Comparação lado a lado -->
        <Grid ColumnDefinitions="*,12,*">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconFolder}" Classes="small" />
                            <TextBlock Text="Origem" FontWeight="Bold" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsSourceNewer}">
                            <TextBlock Text="mais recente" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Separator Margin="0,2" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Classes="subtle" Text="Tamanho" />
                        <TextBlock Grid.Column="1" Text="{Binding Item.FormattedSourceSize}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Classes="subtle" Text="Modificado" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Item.FormattedSourceDate}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="14">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconDrive}" Classes="small" />
                            <TextBlock Text="Destino" FontWeight="Bold" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsDestinationNewer}">
                            <TextBlock Text="mais recente" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Separator Margin="0,2" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Classes="subtle" Text="Tamanho" />
                        <TextBlock Grid.Column="1" Text="{Binding Item.FormattedDestinationSize}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Classes="subtle" Text="Modificado" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Item.FormattedDestinationDate}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Orientação -->
        <Border Classes="warning-banner" IsVisible="{Binding IsDestinationNewer}">
            <TextBlock Text="{Binding DirectionHint}" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !IsDestinationNewer}"
                   Text="{Binding DirectionHint}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                   Text="Ao substituir, a versão atual do destino é guardada em destino/old/ antes de ser trocada." />

        <!-- Ações -->
        <Grid ColumnDefinitions="*,Auto,8,Auto">
            <CheckBox Content="Aplicar aos demais conflitos" IsChecked="{Binding ApplyToAllRemaining}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Ignorar (manter destino)" Command="{Binding IgnoreCommand}" Padding="14,8" />
            <Button Grid.Column="3" Content="Substituir" Command="{Binding ReplaceCommand}" Classes="accent"
                    Padding="18,8" FontWeight="SemiBold" />
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
