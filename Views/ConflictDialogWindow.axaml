<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniSync.ViewModels"
        x:Class="OmniSync.Views.ConflictDialogWindow"
        x:DataType="vm:ConflictDialogViewModel"
        Title="Conflito de Arquivo Detectado"
        Width="580" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="False">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto">
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
            <TextBlock Text="⚠️" FontSize="26" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Conflito de Arquivo Detectado" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="O arquivo abaixo existe em ambos os diretórios, mas seu conteúdo difere." 
                           Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <!-- File Name Box -->
        <Border Grid.Row="1" Background="{DynamicResource SystemChromeLowColor}" 
                CornerRadius="6" Padding="12,8" Margin="0,0,0,16" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1">
            <TextBlock Text="{Binding Item.RelativePath}" FontFamily="Consolas, Cascadia Code, monospace" 
                       FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource AccentButtonBackground}" />
        </Border>

        <!-- Side-by-Side Comparison -->
        <Grid Grid.Row="2" ColumnDefinitions="*,12,*" Margin="0,0,0,16">
            
            <!-- Source Card -->
            <Border Grid.Column="0" Background="{DynamicResource SystemChromeLowColor}" 
                    BorderBrush="{DynamicResource AccentButtonBackground}" BorderThickness="1.5" 
                    CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="📁 Versão na Origem (Nova)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentButtonBackground}" />
                    <Separator Margin="0,2,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Tamanho:" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"/>
                        <TextBlock Text="{Binding Item.FormattedSourceSize}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Data:" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"/>
                        <TextBlock Text="{Binding Item.FormattedSourceDate}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Destination Card -->
            <Border Grid.Column="2" Background="{DynamicResource SystemChromeLowColor}" 
                    BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" 
                    CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="🖧 Versão no Destino (Atual)" FontWeight="Bold" FontSize="13" />
                    <Separator Margin="0,2,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Tamanho:" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"/>
                        <TextBlock Text="{Binding Item.FormattedDestinationSize}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Data:" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"/>
                        <TextBlock Text="{Binding Item.FormattedDestinationDate}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Security Hint -->
        <Border Grid.Row="3" Background="{DynamicResource SystemChromeLowColor}" 
                CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
            <TextBlock Text="💡 Ao substituir, a versão atual do destino será guardada com segurança em destino/old/."
                       FontSize="11.5" Foreground="{DynamicResource SystemBaseMediumColor}" TextWrapping="Wrap" />
        </Border>

        <!-- Actions & Apply to All Checkbox -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,8,Auto">
            <CheckBox Grid.Column="0" Content="Aplicar esta escolha para todos os outros conflitos" 
                      IsChecked="{Binding ApplyToAllRemaining}" 
                      FontSize="12" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="Ignorar (Manter Destino)" 
                    Command="{Binding IgnoreCommand}" 
                    Padding="14,8" FontSize="12" />

            <Button Grid.Column="3" Content="Substituir (Mover p/ old/)" 
                    Command="{Binding ReplaceCommand}" 
                    Classes="accent"
                    Padding="16,8" FontWeight="SemiBold" FontSize="12" />
        </Grid>

    </Grid>
</Window>
